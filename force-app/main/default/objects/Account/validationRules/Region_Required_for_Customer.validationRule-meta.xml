<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Region_Required_for_Customer</fullName>
    <active>true</active>
    <description>Region field is required for Customer record type</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = "Customer",
    ISBLANK(TEXT(Region__c))
)</errorConditionFormula>
    <errorDisplayField>Region__c</errorDisplayField>
    <errorMessage>Region is required for Customer accounts.</errorMessage>
</ValidationRule>
